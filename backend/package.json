{
  "name": "backend-topsis-energia",
  "version": "1.0.0",
  "description": "API RESTful para Plataforma de Vulnerabilidade Social Energética com TOPSIS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "topsis",
    "energia-renovavel",
    "vulnerabilidade-social",
    "express",
    "postgresql"
  ],
  "author": "Engenharia da Computação - SENAI CIMATEC",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/controllers/**/*.js"
    ]
  }
}
